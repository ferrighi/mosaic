<?php

/**
 * @file
 * Theme integration for the Mosaic feature.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function mosaic_help($route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.mosaic') {
    return '<p>' . t('Explore active NBS satellite products by region, mission and acquisition time at the Mosaic Tool page.') . '</p>';
  }
  return NULL;
}

/**
 * Implements hook_theme().
 */
function mosaic_theme($existing, $type, $theme, $path): array {
  return [
    'mosaic' => [
      'variables' => ['results' => NULL],
      'template' => 'mosaic',
    ],
    'mosaic_results' => [
      'variables' => [
        'state' => [], 'result' => [], 'regions' => [],
        'action' => '', 'form_attributes' => [],
      ],
      'template' => 'mosaic-results',
    ],
  ];
}
