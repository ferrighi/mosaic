<section class="mosaic" data-mosaic>
  {{ results }}
  <div class="mosaic__map" data-mosaic-map tabindex="0" aria-label="{{ 'Satellite product map'|t }}"></div>
  <noscript><p>{{ 'Enable JavaScript to view the satellite map. The search filters remain available without JavaScript.'|t }}</p></noscript>
  <p data-mosaic-selected role="status"></p>
  <div class="mosaic__activity" data-mosaic-activity hidden aria-hidden="true"></div>
  <p class="mosaic__status" data-mosaic-status role="status" aria-live="polite"></p>
  <p data-mosaic-error role="alert" hidden></p>
  <p data-mosaic-renderer role="status" hidden></p>
  <div class="mosaic__timeline">
    <label for="mosaic-time">{{ 'Acquisition time window'|t }}</label>
    <input id="mosaic-time" data-mosaic-time type="range" min="0" max="86400" value="86400" step="60">
    <div class="mosaic__ticks" data-mosaic-ticks aria-hidden="true"></div>
    <p><output for="mosaic-time" data-mosaic-time-label></output></p>
    <label for="mosaic-window">{{ 'Window size'|t }}</label>
    <select id="mosaic-window" data-mosaic-window>
      <option value="3600">{{ '1 hour'|t }}</option>
      <option value="21600">{{ '6 hours'|t }}</option>
      <option value="86400" selected>{{ '24 hours'|t }}</option>
    </select>
  </div>
  <div data-mosaic-layer-control hidden>
    <label for="mosaic-layer">{{ 'WMS layer'|t }}</label>
    <select id="mosaic-layer" data-mosaic-layer></select>
  </div>
  <ul class="mosaic__products" data-mosaic-products aria-label="{{ 'Visible products and metadata'|t }}"></ul>
  <p>{{ 'Select a region and satellite mission, then drag the time control to explore recorded products. The initial window covers the last 24 hours. Times are displayed in UTC.'|t }}</p>
</section>
